GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/REPLACE_WITH_YOUR_SHEET_ID/edit
# oauth signs in as yourself. Alternative: service_account
GOOGLE_AUTH_METHOD=oauth
GOOGLE_OAUTH_CLIENT_FILE=secrets/oauth_client.json
GOOGLE_OAUTH_TOKEN_FILE=secrets/authorized_user.json
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/service_account.json
# Paths resolve from repo root. Windows example: G:/My Drive/RestaurantCollector
OUTPUT_DIR=output
